{
  "tasks": {
    "check": "deno fmt --check ops tests deno.json && deno lint ops tests && deno check ops/*.ts && deno test --allow-env=JULIA --allow-read --allow-write --allow-run=git,deno --ignore=tests/docs_math_test.mjs,tests/docs_static_slice_test.ts tests && deno task docs:check && deno task transfer:check && deno task restore:check",
    "transfer:check": "bash -n ops/transfer-github.sh && python3 -m unittest discover -s tests -p 'test_transfer.py'",
    "restore:check": "nix --extra-experimental-features nix-command --store dummy:// --offline eval --json --file tests/restore_site_eval.nix",
    "bootstrap:preflight": "python3 components/qcl-negf-platform/ops/bootstrap_build.py",
    "graph": "deno run --allow-read --allow-run=git ops/git.ts",
    "lab:snapshot": "deno run --allow-read --allow-write --allow-run=git ops/lab_snapshot.ts",
    "prepare": "deno run --allow-read --allow-write --allow-env --allow-run ops/environment.ts sync",
    "lock": "deno run --allow-read --allow-write --allow-env --allow-run ops/environment.ts lock",
    "test": "deno run --allow-read --allow-write --allow-env --allow-run ops/ci.ts",
    "release": "deno run --allow-read --allow-write --allow-env --allow-run ops/release.ts",
    "solver:depot": "deno run --allow-read --allow-write --allow-env --allow-run ops/solver.ts depot",
    "solver:build": "deno run --allow-read --allow-write --allow-env --allow-run ops/solver.ts build",
    "publish": "deno run --allow-read --allow-run=git,gh ops/publish.ts",
    "impact": "deno run --allow-read --allow-run=git ops/impact.ts",
    "docs:plan": "deno run --allow-read --allow-write --allow-env=QCL_NEGF_DOCS_INPUTS --allow-run=git,nix ops/docs.ts plan",
    "docs:prepare": "deno run --allow-read --allow-write --allow-env=QCL_NEGF_DOCS_INPUTS --allow-run=git,nix ops/docs.ts prepare",
    "docs:build": "deno run --allow-read --allow-write --allow-env=QCL_NEGF_DOCS_INPUTS --allow-run=git,nix ops/docs.ts build",
    "docs:check": "deno run --allow-read --allow-write --allow-env=QCL_NEGF_DOCS_NODE,QCL_NEGF_DOCS_PYTHON,QCL_NEGF_DOCS_ASSET_INPUTS --allow-run ops/docs_tests.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
