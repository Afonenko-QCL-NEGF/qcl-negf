+++ b/app/lib/smart_attributes/attributes/auto_memory.rb
@@ -0,0 +1,37 @@
+# frozen_string_literal: true
+
+module SmartAttributes
+  class AttributeFactory
+    def self.build_auto_memory(opts = {})
+      Attributes::AutoMemory.new('auto_memory', opts)
+    end
+  end
+
+  module Attributes
+    class AutoMemory < Attribute
+      def initialize(id, opts)
+        super
+        @opts = @opts.reverse_merge(min: 1, step: 1)
+      end
+
+      def widget
+        'number_field'
+      end
+
+      def value
+        (opts[:value] || '1024').to_s
+      end
+
+      def label(*)
+        (opts[:label] || 'Memory (MiB)').to_s
+      end
+
+      def submit(fmt: nil)
+        raise ArgumentError, 'Memory field requires the HTCondor adapter' unless fmt == 'htcondor'
+        memory = Integer(value, 10)
+        raise ArgumentError, 'Memory must be a positive integer in MiB' unless memory.positive?
+        { script: { native: { request_memory: memory } } }
+      end
+    end
+  end
+end
