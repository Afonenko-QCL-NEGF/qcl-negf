+# frozen_string_literal: true
+
+module SmartAttributes
+  class AttributeFactory
+    def self.build_auto_input_files(opts = {})
+      Attributes::AutoInputFiles.new('auto_input_files', opts)
+    end
+  end
+
+  module Attributes
+    class AutoInputFiles < Attribute
+      def label(*)
+        (opts[:label] || 'Input files').to_s
+      end
+
+      def submit(fmt: nil)
+        raise ArgumentError, 'Input file transfer requires the HTCondor adapter' unless fmt == 'htcondor'
+        { script: { native: { transfer_input_files: value } } }
+      end
+    end
+  end
+end
