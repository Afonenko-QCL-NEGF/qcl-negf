CONDOR_HOST = {{ qcl_manager_address }}
DAEMON_LIST = MASTER, COLLECTOR, NEGOTIATOR, SCHEDD, STARTD, SHARED_PORT
USE_SHARED_PORT = true
SHARED_PORT_ARGS = -p 9618
UID_DOMAIN = qcl
FILESYSTEM_DOMAIN = $(FULL_HOSTNAME)
LOCAL_DIR = /srv/qcl/condor
LOG = $(LOCAL_DIR)/log
SPOOL = $(LOCAL_DIR)/spool
EXECUTE = $(LOCAL_DIR)/execute
LOCK = $(LOCAL_DIR)/lock
RUN = $(LOCAL_DIR)/run
NUM_CPUS = {{ qcl_worker_cpus }}
MEMORY = {{ qcl_worker_memory }}
NUM_SLOTS_TYPE_1 = 1
SLOT_TYPE_1 = cpus=100%,memory=100%,disk=100%
SLOT_TYPE_1_PARTITIONABLE = true
STARTER_ALLOW_RUNAS_OWNER = false
NOBODY_SLOT_USER = qcl
TRUST_UID_DOMAIN = false
SOFT_UID_DOMAIN = false

# Для LAN/mDNS используем IPv4, без link-local IPv6 peer addresses.
ENABLE_IPV4 = true
ENABLE_IPV6 = false

STARTER_JOB_ENVIRONMENT = "JULIA_DEPOT_PATH=/srv/qcl/home/qcl/.julia"
STARTER_SETS_HOME_ENV = true
BASE_CGROUP = htcondor
CGROUP_MEMORY_LIMIT_POLICY = hard
DISABLE_SWAP_FOR_JOB = true
USE_PID_NAMESPACES = true
