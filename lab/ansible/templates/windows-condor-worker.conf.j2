# HTCondor Windows execute-node.
CONDOR_HOST = {{ qcl_manager_address }}
DAEMON_LIST = MASTER, STARTD, SHARED_PORT
USE_SHARED_PORT = True
SHARED_PORT_PORT = 9618

TRUST_DOMAIN = qcl
UID_DOMAIN = qcl
FILESYSTEM_DOMAIN = {{ qcl_windows_filesystem_domain }}
SEC_DEFAULT_AUTHENTICATION_METHODS = NTSSPI, IDTOKENS
SEC_CLIENT_AUTHENTICATION_METHODS = NTSSPI, IDTOKENS
SEC_READ_AUTHENTICATION_METHODS = NTSSPI, IDTOKENS
SEC_DEFAULT_AUTHENTICATION = REQUIRED
SEC_CLIENT_AUTHENTICATION = REQUIRED
SEC_READ_AUTHENTICATION = REQUIRED
SEC_DEFAULT_ENCRYPTION = REQUIRED
SEC_DEFAULT_INTEGRITY = REQUIRED
ALLOW_DAEMON = condor@qcl
ALLOW_NEGOTIATOR = condor@qcl
ALLOW_ADMINISTRATOR = condor@qcl, {{ qcl_windows_discovery.result.admin_identity }}/127.0.0.1, {{ qcl_windows_discovery.result.admin_identity }}/$(IP_ADDRESS)
ALLOW_READ = *@qcl, {{ qcl_windows_discovery.result.admin_identity }}/127.0.0.1, {{ qcl_windows_discovery.result.admin_identity }}/$(IP_ADDRESS)
ALLOW_WRITE = condor@qcl,qcl@qcl
SEC_TOKEN_SYSTEM_DIRECTORY = {{ qcl_windows_token_dir }}
SEC_PASSWORD_DIRECTORY = {{ qcl_windows_signing_dir }}
SEC_TOKEN_POOL_SIGNING_KEY_FILE = {{ qcl_windows_signing_dir }}\POOL

NUM_CPUS = {{ qcl_windows_effective_cpus }}
MEMORY = {{ qcl_windows_effective_memory_mb }}
use FEATURE : PartitionableSlot
STARTER_ALLOW_RUNAS_OWNER = False
