+    active = execute_grant.authorize_docs_setup(request)
+    ensure(re.fullmatch(r"[a-f0-9]{32}", request["setup_id"]), "fresh setup id")
+    ensure(request["scope"] in ("prerequisites-only", "docs-units-only", "full-root-check"), "setup scope")
+    ensure(time.monotonic()+4 < request["monotonic_deadline"] and time.time() < utc_seconds(request["wall_deadline_utc"]), "setup deadline")
