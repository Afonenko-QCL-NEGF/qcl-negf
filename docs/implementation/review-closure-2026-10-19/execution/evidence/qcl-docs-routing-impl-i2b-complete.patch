+// Pure routing contract. Normalized metadata is supplied by a trusted adapter,
+// never deserialized as admission authority from caller-controlled JSON.
+type Ref = { path: string; sha256: string };
+type Tool = Ref & { version: string; receipt_ref: Ref };
+type Unit = { test_path: string; test_sha256: string; expected_tests: number; report_format: string };
+type Limits = {
+  per_step_wall_seconds: number; per_step_log_bytes: number; total_log_bytes: number;
+  cpu: number; ram_bytes: number; node_tmp_bytes: number; python_tmp_bytes: number;
+  doc06_tmp_bytes: number;
+};
+type Inputs = {
+  format: string; source_revision: string; source_files: Ref[];
+  tools: Record<string, Tool>; loader_env: Record<string, never>;
+  units: Record<string, Unit>;
+  katex: { root: string; version: string; module_sha256: string; css_sha256: string; source_receipt_ref: Ref };
+  storage: { owned_tmp_root: string; attempt_dir: string; deno_cache_dir: string };
+  admission_ref: Ref; limits: Limits;
+};
+type Graph = { revision: string; digest: string; clean: boolean };
+type FileFact = { kind: string; canonical: string; sha256: string };
+type DirectoryFact = { kind: string; canonical: string; symlink_ancestors: string[] };
+type Metadata = {
+  workspace: string; source_graph: Graph; source_files: Record<string, string>; base_task: string;
+  files: Record<string, FileFact>; directories: Record<string, DirectoryFact>; absent_paths: string[];
+  retained_tools: Record<string, { ref: Ref; path: string; version: string; sha256: string;
+    schema: string; externally_measured: boolean }>;
+  reviewed_units: Record<string, Unit>;
+  retained_katex: {
+    ref: Ref; root: string; version: string; module_sha256: string; css_sha256: string;
+  };
+  admission: { ref: Ref; source_revision: string; source_graph_digest: string; fresh: boolean;
+    exclusive_storage: string[]; tools: Ref[]; limits: Limits; process_tree_supervision: boolean };
+};
+type Parsed = { inputs: Inputs; input_sha256: string };
+type Ready = Parsed & {
+  result: string; reasons: string[]; workspace: string; source_graph: Graph;
+  versions: Record<string, { evidence: string; measurement: null; version: string }>;
+  license_status: string;
+};
+type Step = {
+  name: string; kind: string; executable: string; args: string[]; cwd: string;
+  clearEnv: boolean; env: Record<string, string>; input_sha256: string; source_graph_digest: string;
+  limits: { wall_seconds: number; log_bytes: number }; task?: string;
+};
+type Plan = { mode: "check" | "docs"; scope: string; input_sha256: string; steps: Step[] };
+type Capture = {
+  stdout: string; stderr: string; exit_code: number | null; signal: string | null;
+  started_at: string; ended_at: string; capture_complete: boolean; drains_complete: boolean;
+  stop_reason: string | null;
+  supervision: { process_tree_owned: boolean; limits_enforced: boolean; evidence_ref: Ref };
+};
+type Executor = { sourceGraph(): Graph | Promise<Graph>; execute(step: Step): Promise<Capture> };
+type Summary = {
+  result?: string; status?: string; reason?: string; expected_tests?: number; observed_tests?: number;
+  passed?: number; failed?: number; skipped?: number; todo?: number | { status: string };
+  cancelled?: number | { status: string }; errors?: number | { status: string };
+};
+type StepReceipt = { name: string; result: string; summary: Summary; capture: Capture | null; reason?: string; plan: Step; input_sha256: string; source_revision: string; source_graph_digest: string; runtime_identity: Tool; attempt_identity: string; stream_identity?: { stdout_sha256: string; stderr_sha256: string; stdout_bytes: number; stderr_bytes: number } };
+const UNIT_NAMES = ["doc04-python", "doc04-node", "doc06-deno"];
+const SOURCES = [
+  "deno.json", "ops/ci.ts", "ops/docs_tests.ts", "tests/docs_test_routing_test.ts",
+  ".github/workflows/ci.yml", ".github/workflows/release.yml", "tests/test_docs_assembly.py",
+  "ops/docs/assemble.py", "tests/docs_math_test.mjs", "ops/docs/math-render.mjs",
+  "tests/docs_static_slice_test.ts", "ops/docs/static-slice.ts",
+];
+const PATHS = ["tests/test_docs_assembly.py", "tests/docs_math_test.mjs", "tests/docs_static_slice_test.ts"];
+const FORMATS = ["python-unittest-summary-v1", "node-test-tap-v1", "deno-test-tap-v1"];
+const MODULE_HASH = "cd4b290a4ecf5068161d6a87745655aa74eb18a6e939fa2872d26520ce261b88";
+const CSS_HASH = "df9ef84e97d38557de02183e238f8ddfd10988b37741492e12c3157bc856011e";
+const MAXIMA: Limits = {
+  per_step_wall_seconds: 120, per_step_log_bytes: 1048576, total_log_bytes: 4194304,
+  cpu: 1, ram_bytes: 1073741824, node_tmp_bytes: 33554432, python_tmp_bytes: 33554432,
+  doc06_tmp_bytes: 8388608,
