+    ensure(bootstrap["python"].startswith("/nix/store/"), "immutable admitted Python required")
+    read_bound_regular({"path": bootstrap["python"], "sha256": bootstrap["python_sha256"]}, active.binary_cap, active.runtime_uid)
+    read_bound_regular({"path": bootstrap["native"], "sha256": bootstrap["native_sha256"]}, 262144, active.uid)
+    ensure(active.runtime_closure_verified(bootstrap), "runtime closure unverified before repo exec")
+    parent, child = socket.socketpair()
+    nonce = secrets.token_hex(32)
+    frame = dict(request, producer=PRODUCER, version=1, nonce=nonce,
+                 parent_registration=active.export_registered_observations())
+    # This method belongs to the pre-existing trusted outer harness, not caller
+    # descriptor data; it pins/attaches the gated stub before first Python exec.
+    process = active.spawn_gated(
+        argv=[bootstrap["python"], "-I", "-S", "-B", bootstrap["native"], "setup", "--control-fd", str(child.fileno())],
+        cwd=request["storage"]["control_dir"], env={}, close_fds=True, pass_fds=(child.fileno(),),
+        durable_intent=audit_intent(frame), deadline=request["monotonic_deadline"],
