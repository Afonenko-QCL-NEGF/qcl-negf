+        spy = {"nonce": "raw-secret", "tokens": ["raw-token"], "setup_id": "a" * 32,
+               "scope": "prerequisites-only", "authorization_ref": {"path": "/a", "sha256": "b" * 64}}
+        projected = native.audit_intent(spy)
+        self.assertNotIn("raw-secret", str(projected))
+        self.assertNotIn("raw-token", str(projected))
