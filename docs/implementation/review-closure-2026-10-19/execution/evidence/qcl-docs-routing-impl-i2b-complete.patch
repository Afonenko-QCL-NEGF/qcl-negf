+// Manufactured permissionless transport tests; no process/FS/environment APIs.
+import { boundedJson, brokerReadGit, hydrateChunks, runDriver } from "../ops/docs_tests_cli.ts";
+function assert(v: unknown): asserts v { if (!v) throw new Error("Assertion failed"); }
+Deno.test("bounded protocol accepts exact object and rejects malformed pairs", () => {
+  assert(boundedJson('{"kind":"prepared"}', 100).kind === "prepared");
+  for (const value of ['[]', '{"x":1,"x":2}', '{}\u0000', 'x'.repeat(101)]) {
+    let refused = false;
+    try { boundedJson(value, 100); } catch { refused = true; }
+    assert(refused);
+  }
+});
+Deno.test("Git reader uses injected transport and preserves NUL framing", async () => {
+  const calls: unknown[] = [];
+  const data = new TextEncoder().encode("tree\u0000\n");
+  const sha = Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256",data)),(v) => v.toString(16).padStart(2,"0")).join("");
+  const emptySha = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
+  let sequence = 0;
+  const read = brokerReadGit(async (request) => {
+    calls.push(request); sequence++;
+    const common = {version:1,request_id:"r",sequence};
+    if (request.op === "git-read") return {...common,kind:"git-capture",ticket_id:"t",exit_code:0,signal:null,complete:true,stop_reason:null,
+      streams:{stdout:{ref:{path:"/retained/out",sha256:sha},bytes:data.length,sha256:sha},stderr:{ref:{path:"/retained/err",sha256:emptySha},bytes:0,sha256:emptySha}}};
+    return {...common,kind:"stream-chunk",ticket_id:"t",stream:request.stream,offset:0,data:request.stream === "stdout" ? "dHJlZQAK" : "",eof:true,chunk_sha256:request.stream === "stdout" ? sha : emptySha};
+  }, "r");
+  assert(await read("/fixture", ["ls-tree", "-rz", "HEAD"]) === "tree\u0000");
+  assert(calls.length === 3);
+});
+Deno.test("Git incomplete and wrong response are refused before parsing", async () => {
+  for (const response of [{ kind: "refused" }, { kind: "git-result", complete: false },
+    { kind: "git-result", request_id: "wrong", sequence: 1, complete: true, text: "" }]) {
+    let refused = false;
+    try { await brokerReadGit(async () => response, "r")("/fixture", ["rev-parse", "HEAD"]); }
+    catch { refused = true; }
+    assert(refused);
+  }
+  let refused = false;
+  try { await hydrateChunks([{ version: 1, request_id: "r", sequence: 1, kind: "chunk",
+    channel: "git", index: 1, count: 1, total_bytes: 1, sha256: "a".repeat(64), data: "eA==" }], "git", "r", 1); }
+  catch { refused = true; }
+  assert(refused);
+});
+Deno.test("driver preflight refusal remains failure without prepare or execute", async () => {
+  const calls: string[] = [];
+  const result = await runDriver({ mode: "preflight", input: "{}", request_id: "r", workspace: "/fixture" }, async (q) => {
+    calls.push(String(q.op)); return { kind: "refused", code: "manufactured" };
+  });
+  assert(result.result !== "passed");
+  assert(calls.join(",") === "preflight");
+});
+
+// Exercise owning sourceGraph itself through the injected seam, never default git.
+import { sourceGraph } from "../ops/git.ts";
+function graphReader(refuseAt = 0) {
+  let calls = 0;
+  const revision = "a".repeat(40);
+  const components = Array.from({ length: 8 }, (_, i) => `component${i}`);
+  return async (root: string, args: readonly string[]) => {
+    if (++calls === refuseAt) throw new Error("manufactured owning reader refusal");
+    const command = args.join(" ");
+    if (command === "rev-parse HEAD") return revision;
+    if (command === "status --porcelain") return "";
+    if (command === "ls-tree -rz HEAD") return root === "/fixture" ?
+      components.map((name) => `160000 commit ${revision}\tcomponents/${name}\u0000`).join("") : "";
+    if (args[0] === "config" && args.includes("--get-regexp")) return components.map((name) => `submodule.${name}.path components/${name}`).join("\n");
+    if (args[0] === "config" && args.includes("--get")) return "https://github.com/example/component.git";
+    throw new Error("Unexpected owning Git argv");
+  };
+}
+Deno.test("owning sourceGraph injected reader preserves eight gitlinks and NUL framing", async () => {
+  const graph = await sourceGraph("/fixture", true, graphReader());
+  assert(graph.components.length === 8 && graph.revision === "a".repeat(40));
+});
+for (const failureAt of [1, 5, 35]) {
+  Deno.test(`owning sourceGraph refusal at read ${failureAt} cannot use default process reader`, async () => {
+    let failed = false;
+    try { await sourceGraph("/fixture", true, graphReader(failureAt)); } catch { failed = true; }
+    assert(failed);
+  });
+}
