+    "--ignore=tests/docs_math_test.mjs --ignore=tests/docs_static_slice_test.ts tests && " +
+    "deno task transfer:check && deno task restore:check" };
+}
+export function parseInputs(text: string): Parsed {
+  requireThat(new TextEncoder().encode(text).length <= 32768, "Descriptor exceeds 32KiB");
+  const d = strictJson(text);
+  object(d, ["format", "source_revision", "source_files", "tools", "loader_env", "units", "katex", "storage", "admission_ref", "limits"]);
+  requireThat(d.format === "qcl-negf.docs-test-inputs.v1", "Unknown descriptor format");
+  requireThat(typeof d.source_revision === "string" && /^[a-f0-9]{40}$/.test(d.source_revision), "Invalid revision");
+  requireThat(Array.isArray(d.source_files) && d.source_files.length === SOURCES.length, "Exact source closure required");
+  for (const item of d.source_files) { object(item,["path","sha256"]); hash(item.sha256); }
+  requireThat(same(d.source_files.map((s) => s.path).sort(), [...SOURCES].sort()), "Invalid source paths");
