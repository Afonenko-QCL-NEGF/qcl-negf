+def _capture_worker(channel, gate, command, deadline, cap, paths, storage):
+    # This fork is a fresh private owner, never the long-lived parent/setup.
+    ensure(ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) == 0, "subreaper unavailable")
+    owner = _CommandOwner(deadline)
+    process = None
+    streams = {}
+    handles = {}
+    result = {"stdout": "", "stderr": "", "exit_code": None, "signal": None,
+              "started_at": utc_now(), "ended_at": None, "capture_complete": False,
+              "drains_complete": False, "stop_reason": None}
+    selector = selectors.DefaultSelector()
+    stopping = [False]
+    signal.signal(signal.SIGTERM, lambda *_: stopping.__setitem__(0, True))
+    try:
+        ensure(os.read(gate, 1) == b"G" and time.monotonic() < deadline, "closed dispatch gate")
+        for name in ("stdout", "stderr"):
+            handles[name] = open(paths[name], "xb", buffering=0)
+            os.chmod(paths[name], 0o600)
+            streams[name] = bytearray()
+        process = subprocess.Popen(command["argv"], cwd=command["cwd"], env=command["env"], close_fds=True,
+                                   stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        for name, pipe in (("stdout", process.stdout), ("stderr", process.stderr)):
+            os.set_blocking(pipe.fileno(), False)
+            selector.register(pipe, selectors.EVENT_READ, name)
+        total = 0
+        work_end = deadline - 2.0
+        while selector.get_map() or process.poll() is None:
+            ensure(not stopping[0] and time.monotonic() < work_end, "command deadline/cancel/cleanup reserve")
+            storage.observe("capture")
+            owner.observe()
+            for key, _ in selector.select(min(0.025, max(0, work_end-time.monotonic()))):
+                data = os.read(key.fileobj.fileno(), 16384)
+                if not data:
+                    selector.unregister(key.fileobj)
+                    key.fileobj.close()
+                    continue
+                total += len(data)
+                # Keep a bounded prefix on overflow, explicitly incomplete.
+                room = max(0, cap - sum(len(v) for v in streams.values()))
+                retained = data[:room]
+                # Reserve is held once by parent before fork. Actual on-disk
+                # prefix is reread below, including short writes before errors.
+                write_all(handles[key.data], retained)
+                streams[key.data].extend(retained)
+                ensure(total <= cap, "combined raw output cap")
+        owner.reap(process)
+        remaining = [r for r in owner.observe().values() if r[2] != b"Z"]
+        ensure(not remaining, "surviving owned producer")
+        result["exit_code"] = process.returncode if process.returncode >= 0 else None
+        result["signal"] = None if process.returncode >= 0 else signal.Signals(-process.returncode).name
+        result["drains_complete"] = True
+        result["capture_complete"] = True
+    except BaseException as exc:
+        result["stop_reason"] = str(exc)[:1024]
+    finally:
+        # Only pidfd/uid/birth owned descendants are signalled.
+        try:
+            owner.signal(signal.SIGTERM)
+            while time.monotonic() < deadline - 0.5 and owner.observe():
+                for key, _ in selector.select(0):
+                    data = os.read(key.fileobj.fileno(),16384)
+                    if not data:
+                        selector.unregister(key.fileobj); key.fileobj.close()
+                    else:
+                        room = max(0,cap-sum(len(v) for v in streams.values()))
+                        write_all(handles[key.data],data[:room]); streams[key.data].extend(data[:room])
+                if process is not None:
+                    owner.reap(process)
+                time.sleep(0.01)
+            owner.signal(signal.SIGKILL)
+            while time.monotonic() < deadline and owner.observe():
+                if process is not None:
+                    owner.reap(process)
+                time.sleep(0.01)
+            ensure(not owner.observe(), "owned cleanup uncertain")
+        except BaseException as exc:
+            result["capture_complete"] = False
+            result["stop_reason"] = result["stop_reason"] or str(exc)[:1024]
+        for handle in handles.values():
+            handle.close()
+        selector.close()
+        owner.close()
+        for name in streams:
+            try:
+                with open(paths[name],"rb",buffering=0) as retained:
+                    data = retained.read(cap+1)
+                ensure(len(data) <= cap,"raw retained cap")
+                result[name] = data.decode("utf-8", "strict")
+            except UnicodeError:
+                result["capture_complete"] = False
+                result["stop_reason"] = "invalid UTF8 retained raw"
+                result[name] = ""
+        result["ended_at"] = utc_now()
+        write_frame(channel, result, 6*cap+65536)
+        ensure(channel.read(1) == b"A", "parent terminal ACK missing")
+
+
+def execute_bounded(command, *, guard, storage, deadline, cap, paths, cancel_fd, debit):
+    ensure(time.monotonic() + 2 < deadline and cap > 0, "capture allocation/cleanup reserve")
+    guard.inspect_binding()
+    storage.observe("prelaunch")
+    debit(cap)  # Single parent-owned reservation, before raw writes/fork.
+    parent, child = socket.socketpair()
+    read_gate, write_gate = os.pipe2(os.O_CLOEXEC)
+    pid = os.fork()
+    if pid == 0:
+        parent.close()
+        os.close(write_gate)
+        try:
+            with child.makefile("rwb", buffering=0) as channel:
+                _capture_worker(channel, read_gate, command, deadline, cap, paths, storage)
+        except BaseException:
+            os._exit(125)
+        os._exit(0)
+    child.close()
+    os.close(read_gate)
+    pidfd = None; birth = None; lease = None; result = None; reaped = False
+    try:
+        birth = proc_birth(pid)
+        pidfd = os.pidfd_open(pid)
+        lease = guard.attach_private_supervisor(pidfd, (pid, birth), command.get("limits"))
+        ensure(time.monotonic() < deadline and not cancelled(cancel_fd), "cancel before gate")
+        os.write(write_gate, b"G")
+        os.close(write_gate)
+        write_gate = -1
+        parent.setblocking(False)
+        pending = bytearray()
+        while time.monotonic() < deadline-0.5:
+            if cancelled(cancel_fd):
+                signal.pidfd_send_signal(pidfd,signal.SIGTERM)
+            try:
+                data = parent.recv(min(16384,6*cap+65537-len(pending)))
+                ensure(data,"supervisor EOF before capture")
+                pending.extend(data)
+                ensure(len(pending) <= 6*cap+65536,"capture frame bound")
+                if b"\n" in pending:
+                    body, tail = pending.split(b"\n",1)
+                    ensure(not tail,"extra supervisor frame")
+                    result = decode(body,6*cap+65536)
+                    break
+            except BlockingIOError:
+                time.sleep(0.01)
+        ensure(result is not None,"capture transport deadline")
+        parent.setblocking(True)
+        with parent.makefile("rwb", buffering=0) as channel:
+            write_all(channel, b"A")
+        while time.monotonic() < deadline:
+            done, status = os.waitpid(pid, os.WNOHANG)
+            if done:
+                reaped = True
+                ensure(os.waitstatus_to_exitcode(status) == 0, "private supervisor failed")
+                break
+            ensure(not cancelled(cancel_fd), "parent cancelled")
+            time.sleep(0.01)
+        else:
+            raise Refusal("supervisor terminal deadline")
+        observation = guard.observe(lease, "terminal")
+        evidence = {"format":"root-docs-command-receipt.v1","command":{k:v for k,v in command.items() if k != "env"},"environment_sha256":digest(canonical(command["env"])),
+                    "capture":{k:v for k,v in result.items() if k not in ("stdout","stderr")},
+                    "streams":raw_streams(paths,cap),"guard":observation,"supervisor":{"pid":pid,"birth":birth,"reaped":reaped}}
+        reference = retain_record(paths["receipt"],evidence,131072)
+        result["supervision"] = {"process_tree_owned": True, "limits_enforced": True,"evidence_ref": reference}
+        storage.observe("terminal")
+        return result
+    finally:
+        if write_gate >= 0:
+            os.close(write_gate)
+        if pidfd is not None and not reaped:
+            try:
+                signal.pidfd_send_signal(pidfd,signal.SIGTERM)
+                while time.monotonic() < deadline:
+                    done, _ = os.waitpid(pid,os.WNOHANG)
+                    if done: reaped = True; break
+                    time.sleep(0.01)
+            except ProcessLookupError:
+                pass
+        # Never kill the sole subreaper while descendants still need cleanup.
+        # Outer parent watchdog owns escalation if this owner cannot finish.
+        if not reaped:
+            try:
+                retain_record(paths["fallback"],{"format":"root-docs-command-failure.v1","pid":pid,"birth":birth,
+                    "cleanup":"unknown","raw_paths":{k:paths[k] for k in ("stdout","stderr")}},16384)
+            except (OSError,Refusal):
+                pass
+        if pidfd is not None: os.close(pidfd)
+        parent.close()
+
+
+def retain_record(path, record, maximum):
+    data = canonical(record)
+    ensure(len(data) <= maximum,"retained metadata cap")
+    fd = os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,0o600)
+    try:
+        offset = 0
+        while offset < len(data):
+            n = os.write(fd,data[offset:]); ensure(n > 0,"retained short write"); offset += n
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    return {"path":str(path),"sha256":digest(data)}
+
+
+def raw_streams(paths,cap):
+    result = {}
+    for name in ("stdout","stderr"):
+        path = paths[name]
+        fd = os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC)
+        try:
+            info = os.fstat(fd); ensure(stat.S_ISREG(info.st_mode) and info.st_size <= cap,"raw stream identity/cap")
+            data = bytearray()
+            while len(data) <= cap:
+                part = os.read(fd,min(65536,cap+1-len(data)))
+                if not part: break
+                data.extend(part)
+            ensure(len(data) == info.st_size and info.st_mtime_ns == os.fstat(fd).st_mtime_ns,"raw stream drift")
+            sha = digest(data)
+            result[name] = {"ref":{"path":str(path),"sha256":sha},"bytes":len(data),"sha256":sha}
+        finally: os.close(fd)
+    return result
+
+
+def cancelled(fd):
+    if fd is None:
+        return True
+    selector = selectors.DefaultSelector()
+    try:
+        selector.register(fd, selectors.EVENT_READ)
+        if selector.select(0):
+            return os.read(fd, 1) != b"K"
+        return False
+    finally:
+        selector.close()
