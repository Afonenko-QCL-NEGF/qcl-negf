+class ActiveDocsAttempt:
+    """Only constructed on the directly inherited, continuously live parent FD.
+
+    The attachment is an immutable projection of the parent-held registrations;
+    it is never accepted by the public client or loaded from a caller file.
+    """
+    def __init__(self,startup,channel):
+        ensure(channel is not None and channel.fileno() >= 3,"live inherited parent required")
+        ensure(startup["producer"] == PRODUCER and startup["version"] == 1,"registered producer")
+        self.channel = channel; self.request = startup
+        self.uid = os.getuid(); self.setup_id = startup["setup_id"]
+        self.deadline = startup["monotonic_deadline"]
+        self.wall_deadline_utc = startup["wall_deadline_utc"]
+        self.source_head = startup["expected_source"]["head"]
+        self.authorization_ref = startup["authorization_ref"]
+        self.registration = startup["parent_registration"]
+        # These are independently registered by the trusted parent, not supplied
+        # by descriptor true fields. Unknown attachment shape fails closed.
+        required = ("uid","runtime_uid","binary_cap","setup_inventory_id","observation_registration",
+                    "native_receipt_sha","accepted_native_captures","runtime_closures",
+                    "katex","reviewed_units","admission","initial_empty","allocation","control_reserve","base_environment")
+        exact(self.registration,required)
+        ensure(self.registration["uid"] == self.uid,"registered owner")
+        for key in ("runtime_uid","binary_cap","setup_inventory_id","native_receipt_sha","accepted_native_captures"):
+            setattr(self,key,self.registration[key])
+        self.observation_registration = {tuple(row) for row in self.registration["observation_registration"]}
+        self.expected_tools = startup["expected_tools"]
+        self.base_environment = self.registration["base_environment"]
+        ensure(len(self.base_environment) <= 256 and len(canonical(self.base_environment)) <= 32768 and
+               all(isinstance(k,str) and isinstance(v,str) and len(v.encode()) <= 4096 and not k.startswith("QCL_DOCS_") for k,v in self.base_environment.items()),"base pre-routing environment")
+        resource = startup["resources"]
+        self.guard = CgroupGuard(resource["path"],resource["limits"],resource["pids_max"],self.uid)
+        self.guard.inspect_binding()
+        initial = self.registration["initial_empty"]
+        read_bound_regular(initial["ref"],16384,self.uid)
+        ensure(initial["populated"] == 0 and initial["allocation_ref"] == self.registration["allocation"]["ref"] and
+               initial["monotonic"] <= time.monotonic() and initial["producer_birth"] == proc_birth(os.getpid()),"parent pre-bootstrap empty binding")
+        reserve = self.registration["control_reserve"]
+        ensure(0 < reserve["memory_bytes"] <= 134217728 and reserve["metadata_bytes"] >= 884736 and reserve["log_bytes"] >= 32768,"lifecycle/fallback control reserve")
+        ensure(utc_seconds(self.now_utc()) < utc_seconds(self.wall_deadline_utc) and time.monotonic()+4 < self.deadline,"active allocation deadline")
+        roots = startup["storage"]["roots"]
+        self.storage = StorageLedger(roots,startup["storage"]["limits"],startup["storage"]["total"],self.deadline,True)
+        self.raw_root = roots["raw"]; self.metadata_root = roots["metadata"]
+        self.sequence = 0; self.git_calls = 0; self.git_raw = 0; self.git_seconds = 0
+        self.tickets = {}; self.captures = []; self.command_index = 0
+        self.leaders = {}; self.phases = []; self.closed = False; self.wire_bytes = 0
+        self.components = {startup["expected_source"]["workspace"]+"/"+item["path"]:item["section"] for item in startup["expected_source"]["components"]}
+        ensure(len(self.components) == 8,"exact eight selected components")
+        self.workspace = startup["expected_source"]["workspace"]
+
+    def now_utc(self): return utc_now()
+
+    def poll_parent(self):
+        ensure(time.monotonic() < self.deadline,"setup deadline")
+        self.guard.inspect_binding()
+        selector = selectors.DefaultSelector()
+        try:
+            selector.register(self.channel,selectors.EVENT_READ)
+            if selector.select(0):
+                first = self.channel.recv(1,socket.MSG_PEEK)
+                ensure(first and first != b"C","parent EOF/cancel")
+        finally: selector.close()
+
+    def retain(self,kind,record,maximum=131072):
+        data = canonical(record); self.storage.debit("metadata",len(data))
+        return retain_record(Path(self.metadata_root)/(kind+"-"+secrets.token_hex(16)+".json"),record,maximum)
+
+    def command(self,command,cap,wall):
+        self.poll_parent()
+        ident = secrets.token_hex(16)
+        paths = {name:str(Path(self.raw_root)/(ident+"."+name)) for name in ("stdout","stderr")}
+        paths.update(receipt=str(Path(self.metadata_root)/(ident+".json")),fallback=str(Path(self.metadata_root)/(ident+".failure.json")))
+        self.storage.debit("metadata",147456)
+        result = execute_bounded(command,guard=self.guard,storage=self.storage,
