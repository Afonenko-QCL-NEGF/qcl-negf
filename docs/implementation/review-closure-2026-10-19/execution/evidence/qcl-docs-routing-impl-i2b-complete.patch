+    object(tool, ["path","version","sha256","receipt_ref"]); absolute(tool.path); hash(tool.sha256);
+    requireThat(typeof tool.version === "string" && /^\d+\.\d+\.\d+$/.test(tool.version), "Invalid version");
+    reference(tool.receipt_ref);
+  }
+  object(d.units, UNIT_NAMES);
