+        ensure(limits["cpu"] == 1 and 0 < limits["ram_bytes"] <= 1073741824, "cgroup resource profile")
+        self.initial_events = self.events()
+
+    def events(self):
+        return dict(line.split() for line in (self.path / "memory.events").read_text().splitlines())
+
+    def inspect_binding(self, _ctx=None):
+        controllers = (self.path / "cgroup.controllers").read_text().split()
+        ensure(all(c in controllers for c in ("cpu", "memory", "pids")), "unknown cgroup controllers")
+        for name, value in self.limits.items():
+            target = self.path / name
+            ensure(os.access(target, os.W_OK) and target.read_text().strip() == value, "cgroup controls not delegated/exact")
+        return {"path": str(self.path), "limits": self.limits.copy(), "events": self.events()}
+
+    def attach_private_supervisor(self, pidfd, expected_birth, _limits=None):
+        pid = expected_birth[0]
+        ensure(proc_birth(pid) == expected_birth[1], "supervisor birth changed")
+        ensure(pidfd >= 0, "pidfd required before attach")
+        (self.path / "cgroup.procs").write_text(str(pid))
+        ensure(pid in [int(v) for v in (self.path / "cgroup.procs").read_text().split()], "supervisor membership missing")
+        self.inspect_binding()
+        return {"pid": pid, "birth": expected_birth[1]}
+
+    def observe(self, lease, phase):
+        self.inspect_binding()
+        events = self.events()
+        ensure(all(events.get(k) == self.initial_events.get(k) for k in ("oom", "oom_kill", "max")), "cgroup memory event")
+        return {"phase": phase, "lease": lease, "events": events}
+
+    def close_and_verify_empty(self, lease):
+        events = dict(line.split() for line in (self.path / "cgroup.events").read_text().splitlines())
+        ensure(events.get("populated") == "0", "owned cgroup not empty")
+        return self.observe(lease, "terminal-empty")
