+"""Manufactured protocol controls; never launch a product process or cgroup."""
+import importlib.util
+import io
+from pathlib import Path
+import sys
+import unittest
+
+_spec = importlib.util.spec_from_file_location("docs_native", Path(__file__).resolve().parents[1] / "ops/docs_tests_native.py")
+native = importlib.util.module_from_spec(_spec)
+sys.modules[_spec.name] = native
+_spec.loader.exec_module(native)
+
+
+class ProtocolTests(unittest.TestCase):
+    def test_frame_round_trip(self):
+        sink = io.BytesIO()
+        native.write_frame(sink, {"op": "preflight", "input": "{}"}, 100)
+        self.assertEqual(native.read_frame(io.BytesIO(sink.getvalue()), 100), {"op": "preflight", "input": "{}"})
+        # A capsule conveys binding, never authority; canonical alternatives fail.
+        binding = native.phase_binding({"setup_id": "a" * 32, "scope": "docs-units-only",
+            "expected_source": {"head": "b" * 40, "graph_digest": "c" * 64,
+                "native_digest": "d" * 64}, "runtime_inventory_digest": "e" * 64},
+            {"phase": "docs", "attempt": "unit", "input_sha256": "f" * 64,
+             "source_head": "b" * 40, "not_after_utc": "2026-10-20T12:00:00.000000Z"},
+            "01" * 32, "02" * 32)
+        capsule = native.encode_capsule("02" * 32, binding)
+        self.assertEqual(native.decode_capsule(capsule)["binding"], binding)
+        for bad in (capsule + "=", capsule + " ", "qcl-docs-phase-v1.e30"):
+            with self.assertRaises(native.Refusal):
+                native.decode_capsule(bad)
+
+    def test_frame_negative_pairs(self):
+        for wire in [b'{"x":1,"x":2}\n', b'{}', b'\xff\n', b'[]\n', b'{}\x00\n', b' ' * 101 + b'\n']:
+            with self.subTest(wire=wire):
+                with self.assertRaises(native.Refusal):
+                    native.read_frame(io.BytesIO(wire), 100)
+        body = b"\xff\x00" * 16384
+        self.assertEqual(native.unbase64url(native.base64url(body), 32768), body)
+        for bad in (native.base64url(body) + "=", "eA ", "eB"):
+            with self.assertRaises(native.Refusal):
+                native.unbase64url(bad, 32768)
+
+    def test_source_git_closed_argv(self):
+        root = "/fixture/source"
+        self.assertEqual(native.validate_git(root, ["rev-parse", "HEAD"], root, []), ["rev-parse", "HEAD"])
+        for args in [["--version"], ["status", "--porcelain", ";bad"], ["cat-file", "blob", "HEAD:unbound"]]:
+            with self.assertRaises(native.Refusal):
+                native.validate_git(root, args, root, [])
+        with self.assertRaises(native.Refusal):
+            native.validate_git("/outside", ["rev-parse", "HEAD"], root, [])
+        sections = {"/fixture/source/components/core": "submodule.nonbasename"}
+        self.assertEqual(native.validate_git(root, ["config", "-f", ".gitmodules", "--get",
+            "submodule.nonbasename.url"], root, sections)[-1], "submodule.nonbasename.url")
+
+    def test_phase_token_is_once_and_bound(self):
+        phase = {"phase": "check", "attempt": "a", "input_sha256": "b" * 64, "source_head": "c" * 40, "not_after_utc": 20}
+        ledger = native.PhaseLedger([phase], ["d" * 64], now=lambda: 10)
+        hello = {"version": 1, "setup_id": "e" * 32, "phase": "check", "attempt": "a", "input_sha256": "b" * 64, "source_head": "c" * 40, "token": "d" * 64, "client_pid": 12, "client_startticks": 34}
+        bad = dict(hello, input_sha256="f" * 64)
