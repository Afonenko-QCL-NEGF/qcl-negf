+def read_tool_observation(tool, ref, active):
+    bound = read_bound_regular(ref, 16384, active.uid)
+    record = decode(bound["bytes"], 16384)
+    fields = ("format", "producer", "setup_id", "tool", "producer_source_sha256", "parent_execution_ref", "source_head", "executable", "runtime_closure_ref", "version", "command", "clear_env", "environment", "capture", "measured_at_utc", "expires_at_utc", "duration_ns", "binding_digest")
+    exact(record, fields)
+    ensure(record["format"] == "root-docs-tool-observation.v1" and record["producer"] == PRODUCER, "unknown observation producer")
+    expected = active.expected_tools[tool]
+    key = (record["producer_source_sha256"], tool, ref["sha256"], active.native_receipt_sha[tool], record["runtime_closure_ref"]["sha256"], active.setup_inventory_id)
+    ensure(key in active.observation_registration, "observation not independently parent-registered")
+    ensure(record["setup_id"] == active.setup_id and record["source_head"] == active.source_head and record["parent_execution_ref"] == active.authorization_ref, "observation execution binding")
+    exact(record["executable"], ("path", "sha256"))
+    ensure(record["executable"] == {"path": expected["path"], "sha256": expected["sha256"]}, "tool inventory mismatch")
+    read_bound_regular(record["executable"], active.binary_cap, active.runtime_uid)
+    ensure(record["clear_env"] is True and record["environment"] == {}, "observation environment")
+    runtime_ref = record["runtime_closure_ref"]
+    exact(runtime_ref,("path","sha256"))
+    ensure(runtime_ref == active.registration["runtime_closures"][tool]["ref"],"registered runtime closure")
+    closure = read_bound_regular(runtime_ref,131072,active.runtime_uid)
+    ensure(closure["sha256"] == active.registration["runtime_closures"][tool]["ref"]["sha256"],"actual runtime closure")
+    command = [expected["path"], "--version"] if tool != "python" else [expected["path"], "-I", "-S", "-B", "--version"]
+    ensure(record["command"] == command, "observation probe command")
+    capture = record["capture"]
+    exact(capture, ("stdout_ref", "stderr_ref", "stdout_bytes", "stderr_bytes", "exit_code", "signal", "complete", "stop_reason"))
+    out = read_bound_regular(capture["stdout_ref"], 4096, active.uid)["bytes"]
+    err = read_bound_regular(capture["stderr_ref"], 4096, active.uid)["bytes"]
+    ensure(len(out)+len(err) <= 4096 and len(out) == capture["stdout_bytes"] and not err and capture["stderr_bytes"] == 0, "observation raw sizes")
+    ensure(capture["exit_code"] == 0 and capture["signal"] is None and capture["complete"] is True and capture["stop_reason"] is None, "observation capture status")
+    ensure(active.accepted_native_captures[tool] == capture, "capture lacks parent registration")
+    ensure(parse_version(tool, out) == record["version"] == expected["version"], "tool version mismatch")
+    ensure(record["measured_at_utc"] <= active.now_utc() < record["expires_at_utc"] <= active.wall_deadline_utc, "stale/future observation")
+    ensure(record["binding_digest"] == digest(canonical({k:v for k,v in record.items() if k != "binding_digest"})), "observation digest")
+    return record
