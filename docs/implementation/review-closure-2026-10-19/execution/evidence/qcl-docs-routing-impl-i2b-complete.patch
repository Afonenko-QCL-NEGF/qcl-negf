+function requireThat(value: unknown, reason: string): asserts value {
+  if (!value) throw new Error(reason);
+}
+function same(a: unknown, b: unknown): boolean { return JSON.stringify(a) === JSON.stringify(b); }
+function object(value: unknown, keys: string[]): asserts value is Record<string, unknown> {
+  requireThat(value !== null && typeof value === "object" && !Array.isArray(value), "Expected object");
+  requireThat(same(Object.keys(value).sort(), [...keys].sort()), "Missing or additional fields");
+}
+function hash(value: unknown): asserts value is string {
+  requireThat(typeof value === "string" && /^[a-f0-9]{64}$/.test(value), "Invalid SHA256");
+}
+function absolute(value: unknown): asserts value is string {
+  requireThat(typeof value === "string" && value.startsWith("/") && value !== "/" &&
+    !/[\x00-\x20\x7f,\\]/.test(value) && !value.endsWith("/") &&
+    !value.split("/").slice(1).some((s) => !s || s === "." || s === ".."), "Invalid canonical path spelling");
+}
+function reference(value: unknown): asserts value is Ref {
+  object(value, ["path", "sha256"]); absolute(value.path); hash(value.sha256);
+}
+function inside(path: string, root: string): boolean { return path === root || path.startsWith(root + "/"); }
+function overlap(a: string, b: string): boolean { return inside(a, b) || inside(b, a); }
+
+// Strict JSON reader rejects duplicate decoded member names at every level.
+function strictJson(text: string): unknown {
+  let i = 0;
+  const ws = () => { while (/[ \t\r\n]/.test(text[i] ?? "") && i < text.length) i++; };
+  const string = (): string => {
+    const start = i++;
+    while (i < text.length) {
+      if (text[i] === "\\") { i += 2; continue; }
+      if (text[i++] === '"') return JSON.parse(text.slice(start, i));
+    }
+    throw new Error("Unterminated JSON string");
+  };
+  const value = (): unknown => {
+    ws();
+    if (text[i] === '"') return string();
+    if (text[i] === "{") {
+      i++; ws(); const result: Record<string, unknown> = Object.create(null);
+      if (text[i] === "}") { i++; return result; }
+      while (true) {
+        ws(); requireThat(text[i] === '"', "Expected JSON member");
+        const key = string(); requireThat(!Object.hasOwn(result, key), "Duplicate JSON member");
+        ws(); requireThat(text[i++] === ":", "Expected colon"); result[key] = value(); ws();
+        const end = text[i++]; if (end === "}") return result;
+        requireThat(end === ",", "Expected comma");
+      }
+    }
+    if (text[i] === "[") {
+      i++; ws(); const result: unknown[] = [];
+      if (text[i] === "]") { i++; return result; }
+      while (true) {
+        result.push(value()); ws(); const end = text[i++]; if (end === "]") return result;
+        requireThat(end === ",", "Expected comma");
+      }
+    }
+    const token = /^(?:true|false|null|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/.exec(text.slice(i));
+    requireThat(token, "Invalid JSON token"); i += token[0].length; return JSON.parse(token[0]);
+  };
+  const result = value(); ws(); requireThat(i === text.length, "Trailing JSON data"); return result;
+}
+
+// Synchronous SHA256 keeps parseInputs import-safe and deterministic.
+function sha256(text: string): string {
+  const data = new TextEncoder().encode(text);
+  const bytes = new Uint8Array(Math.ceil((data.length + 9) / 64) * 64);
+  bytes.set(data); bytes[data.length] = 128;
+  const view = new DataView(bytes.buffer);
+  view.setUint32(bytes.length - 4, data.length * 8);
+  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
+  const k = [0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
+  const r = (x: number, n: number) => (x >>> n) | (x << (32 - n));
+  for (let offset = 0; offset < bytes.length; offset += 64) {
+    const w = new Uint32Array(64);
+    for (let j = 0; j < 16; j++) w[j] = view.getUint32(offset + j * 4);
+    for (let j = 16; j < 64; j++) {
+      const x = w[j - 15], y = w[j - 2];
+      w[j] = (w[j - 16] + (r(x,7)^r(x,18)^(x>>>3)) + w[j - 7] + (r(y,17)^r(y,19)^(y>>>10))) >>> 0;
+    }
