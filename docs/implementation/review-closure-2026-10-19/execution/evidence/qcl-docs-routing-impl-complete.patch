+
+// These parser-only controls cannot be satisfied by missing filesystem,
+// admission or source closure facts: those adapters are never consulted.
+for (const location of ["owned_tmp_root", "attempt_dir", "deno_cache_dir"] as const) {
+  for (const value of ["relative", "/tmp/a,b", "/tmp/a\nb", "/tmp/a/../b"]) {
