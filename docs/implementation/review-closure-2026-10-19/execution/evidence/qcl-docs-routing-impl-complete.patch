+for (const location of ["owned_tmp_root", "attempt_dir", "deno_cache_dir"] as const) {
+  Deno.test(`${location} accepts an independently rebound healthy relocation`, () => {
+    const { d, m } = relocatedStorage(location, safeRelocations[location]);
+    const result = preflightInputs(parseInputs(JSON.stringify(d)), m);
+    equal(result.result, "ready_for_unit_attempt");
+    equal(m.admission.exclusive_storage.includes(d.storage[location]), true);
+    equal(d.admission_ref.sha256, m.files[d.admission_ref.path].sha256);
