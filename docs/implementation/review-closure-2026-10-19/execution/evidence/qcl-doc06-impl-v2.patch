+    packagedInput.actual_sha256 !== schemaInput.actual_sha256) diagnostics.push({ reason: "packaged_schema_mismatch" });
+  function add(subject: Subject, name: string, status: Status, text: string, context: string,
+    observation?: Observation, input?: Input, mode?: Mode) {
+    if (text.length > 2048) refuse("fact_text_cap");
+    const sources = input && observation ? sourceRef(input, observation.selector) : [];
+    const fact_index = subject.facts.length;
+    subject.facts.push({ name, status, text, sources });
+    extractions.push({ subject: subject.key, fact_index,
+      mode: mode ?? (observation?.reason ? "dynamic-unknown" : "authored-context"),
+      context, value: observation?.value ?? null, selector: observation?.selector ?? null,
+      ...(observation?.reason ? { reason: observation.reason } : {}) });
+  }
+  function literal(subject: Subject, name: string, context: string, observation: Observation,
+    input: Input, label: string, known: Status = "known") {
+    add(subject, name, observation.reason ? (observation.reason === "source_missing" ? "unknown" : "partial") : known,
+      observation.reason ? `${label}: извлечение недоступно (${observation.reason}); значение не вычислялось.`
+        : `${label}: ${typeof observation.value === "string" ? observation.value : JSON.stringify(observation.value)}. Это декларация исходного текста.`,
+      context, observation, input, observation.reason ? "dynamic-unknown" : "literal-extraction");
+  }
+  // API literal documentation is distinct from the nonexhaustive typed header.
+  literal(api, "signature", "documented-signature", observedApi.documented, apiInput, "Документированная сигнатура");
+  literal(api, "signature", "typed-signature", observedApi.typed, apiInput, "Текстовый typed header; не полный список методов", "partial");
+  add(api, "units", "not_applicable", "Авторский контекст: идентификатор источника или nothing не является физической величиной.", "units");
+  add(api, "default", observedApi.typed.reason ? "partial" : "not_assigned",
+    observedApi.typed.reason ? "Аргументные defaults не установлены: header не распознан."
+      : "В распознанном текстовом header аргументные defaults не объявлены; методы не исполнялись.",
+    "argument-defaults", observedApi.typed, apiInput);
+  add(api, "constraint", "partial", "Текстовый header описывает ResolvedRunConfiguration и AbstractString; lookup не подтверждает schema validation и полный dispatch contract.",
+    "typed-constraints", observedApi.typed, apiInput);
+  if (!observedApi.doc.reason) {
+    add(api, "effects", "known", "Документированное описание (не runtime effect inventory):\n" + String(observedApi.doc.value),
+      "documented-effects", observedApi.doc, apiInput, "literal-extraction");
+  } else {
+    add(api, "effects", "unknown", "Документированное описание lookup недоступно; effects не восстанавливались из тела функции.",
+      "documented-effects", observedApi.doc, apiInput, "dynamic-unknown");
+  }
+  add(api, "errors", "partial", "Docstring и header не являются исчерпывающим throws/error contract; вызов не выполнялся.", "errors", observedApi.doc, apiInput);
+  add(api, "formula_origin", "not_applicable", "Авторский контекст: lookup provenance не задаёт физическую формулу.", "formula-origin");
+  add(api, "value_origin", "not_applicable", "Физическое происхождение численного значения к этому lookup не применяется; фактический возвращённый identifier не задан.", "value-origin");
+  add(api, "assigning_origin", "partial", "Статическое документированное правило относится к recorded assigning history; фактическая history отсутствует. Полная causal chain не восстановлена.",
+    "assigning-origin", observedApi.doc, apiInput);
+  add(api, "effective_origin", "unknown", "Retained run/execution context отсутствует; effective origin неизвестен.", "effective-origin");
+
+  const constraint = observedSchema.constraint;
+  const declaredDefault = observedSchema.declaration;
+  literal(leaf, "signature", "schema-type", constraint.reason ? constraint
+    : { value: "integer", selector: constraint.selector + "/type" }, schemaInput, "Объявленный тип owning schema");
+  literal(leaf, "signature", "typed-field", observedTyped.reason ? observedTyped
+    : { value: "energy_chunk::Int", selector: observedTyped.selector }, coreInput, "Текстовая Int field declaration; не runtime inventory", "partial");
+  // Copy owning description; scheduling interpretation is explicitly authored.
+  if (!observedSchema.description.reason) {
+    add(leaf, "units", "known", "Owning schema description (source declaration): " + String(observedSchema.description.value),
+      "units", observedSchema.description, schemaInput, "literal-extraction");
+  } else {
+    add(leaf, "units", "unknown", "Owning description отсутствует; физические единицы из имени не выводятся.", "units", observedSchema.description, schemaInput);
+  }
+  literal(leaf, "default", "schema-default", declaredDefault, schemaInput,
+    "Default в schema context; декларация не применяется к конфигурации", declaredDefault.value === null ? "not_assigned" : "known");
+  literal(leaf, "default", "typed-default", observedTyped, coreInput, "Отдельная текстовая default declaration ProductionOptions");
+  literal(leaf, "default", "example-explicit", observedExample, exampleInput, "Отдельное явное значение illustrative base fixture; не default");
+  literal(leaf, "constraint", "schema-constraint", constraint, schemaInput, "Прямые type/minimum/required декларации owning schema; не полный validator");
+  literal(leaf, "constraint", "root-production-required", observedSchema.rootRequired, schemaInput, "Root required-production membership");
+  add(leaf, "effects", observedSchema.description.reason ? "unknown" : "partial",
+    "Авторский контекст: параметр планирования energy-node work; этот adapter не меняет сетку/физическую модель и не исполняет scheduling. Owning description приведено отдельно; полный effect inventory не установлен.",
+    "effects", observedSchema.description, schemaInput);
+  add(leaf, "errors", "partial", "Прямые schema declarations не являются полным loader error inventory. Core guard/body не интерпретируются; runtime exception path не проверен.",
+    "errors", { value: null, selector: "file" }, coreInput);
+  add(leaf, "formula_origin", "not_applicable", "Авторский контекст: scheduling count не предоставляет физическую формулу; формула NEGF или rationale допуска не генерируются.",
+    "formula-origin", observedSchema.description, schemaInput);
+  add(leaf, "value_origin", "partial", "Schema, typed declaration и явный example — отдельные source contexts. Actual instance numeric origin неизвестен; совпадение чисел не является provenance.",
+    "value-origin");
+  // Only authored excerpts are copied; fenced configuration/inspection code is not run.
+  const route = routeInput.text;
+  const marker = route?.indexOf("## Recorded assignments and value origins") ?? -1;
+  const next = route && marker >= 0 ? route.indexOf("\n\n", marker) : -1;
+  const paragraphStart = next >= 0 ? next + 2 : -1;
+  const paragraphEnd = route && paragraphStart >= 0 ? route.indexOf("\n\n", paragraphStart) : -1;
+  const excerpt = route && paragraphStart >= 0 && paragraphEnd >= 0 ? route.slice(paragraphStart, paragraphEnd) : null;
+  const routeObservation: Observation = route === null ? missing("configuration-route")
+    : excerpt ? { value: excerpt, selector: `configuration-route:L${lines(route, paragraphStart)}` }
+      : failed("configuration-route", "authored_excerpt_unavailable");
+  add(leaf, "assigning_origin", "partial", excerpt
+    ? "Авторский контекст из owning route; actual assigning history отсутствует:\n" + excerpt
+    : "Actual assigning identifier неизвестен: source files, generated policy и effective ExecutionPlan не восстановлены из defaults или example.",
+    "assigning-origin", routeObservation, routeInput, excerpt ? "authored-context" : "dynamic-unknown");
+  if (route !== null) {
+    // These are literal authored paragraphs, never results of a merge/planner.
+    const paragraphs = route.split(/\n\s*\n/);
+    for (const [context, matches] of [
