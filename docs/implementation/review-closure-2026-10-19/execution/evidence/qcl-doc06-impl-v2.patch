+      typeof item.bytes !== "number" || !Number.isSafeInteger(item.bytes) || item.bytes < 0) refuse("invalid_source_identity");
+    if (item.bytes > FILE_CAP) refuse("input_byte_cap");
+    files.push({ path: item.path, owner, revision: item.revision, sha256: item.sha256, bytes: item.bytes });
