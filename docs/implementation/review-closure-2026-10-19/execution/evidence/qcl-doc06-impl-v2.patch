+      ["authored-planner-policy", (p: string) => /application:auto_exact/.test(p)],
+    ] as const) {
+      const candidates = paragraphs.filter(matches);
+      if (candidates.length === 1) {
+        const paragraph = candidates[0];
+        add(leaf, "assigning_origin", "partial", "Цитата owning route; синтетическое/статическое объяснение, не результат выполнения:\n" + paragraph,
