+    external_binding: "Receipt hashes verify supplied bytes only; external source preparation must prove commit-to-bytes binding.",
+    lexical_normalization: "UTF-8 strict; CRLF/CR normalized to LF for extraction; hashes use raw bytes",
+    inputs: inputs.map(({ text: _text, sha256, bytes: expectedBytes, ...input }) => ({
+      ...input, expected_sha256: sha256, expected_bytes: expectedBytes,
+    })),
+    extractions, diagnostics,
+    aggregate_source_bytes: inputs.reduce((sum, input) => sum + (input.actual_bytes ?? 0), 0),
+    result: "partial" as const,
