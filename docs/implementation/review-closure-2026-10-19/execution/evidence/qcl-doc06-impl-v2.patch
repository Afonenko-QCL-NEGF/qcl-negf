+  const root = object(value);
+  if (root.format !== "qcl-negf.doc06-source-input.v1" ||
+    typeof root.source_graph_sha256 !== "string" || !/^[a-f0-9]{64}$/.test(root.source_graph_sha256) || !Array.isArray(root.files)) refuse("invalid_source_receipt");
