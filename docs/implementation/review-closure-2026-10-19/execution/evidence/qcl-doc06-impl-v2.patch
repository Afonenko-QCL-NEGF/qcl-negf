+type Status = "known" | "partial" | "unknown" | "not_assigned" | "not_applicable";
+type Mode = "literal-extraction" | "authored-context" | "dynamic-unknown";
+type SourceRef = { owner: string; revision: string; path: string; sha256: string; selector: string };
+type Fact = { name: string; status: Status; text: string; sources: SourceRef[] };
+type Extraction = { subject: string; fact_index: number; mode: Mode; context: string;
+  value: unknown; selector: string | null; reason?: string };
